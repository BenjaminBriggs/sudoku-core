        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin embargo, este patrón tiene candidatos adicionales (aletas) que le impiden ser un pez perfecto:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
