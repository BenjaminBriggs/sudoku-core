    "Digit %lld appears exactly twice in a row and exactly twice in a column, with one cell from each sharing the same box." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziffer %lld kommt genau zweimal in einer Zeile und zweimal in einer Spalte vor, wobei jeweils eine Zelle in beiden Gruppen im selben Block liegt."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digit %lld appears exactly twice in a row and exactly twice in a column, with one cell from each sharing the same box."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digit %lld shows up exactly twice in a row and twice in a column, with one cell from each sharing a box."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dígito %lld aparece exactamente dos veces en una fila y dos veces en una columna, compartiendo una celda en la misma caja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiffre %lld apparaît exactement deux fois sur une ligne et deux fois sur une colonne, avec une case de chaque partageant le même bloc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数字%lldが1行にちょうど2回、1列にも2回現れ、それぞれのうち1つが同じボックスを共有します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숫자 %lld이(가) 한 행과 한 열에 각각 두 번씩 등장하며, 각 행과 열의 칸이 같은 박스를 공유합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数字%lld在一行和一列中各出现两次，且每行/列有一个单元格在同一宫内。"
          }
        }
      }
    },
    "Each %@ can only contain the digit %lld once." : {
      "comment" : "Explanation of the rule that is violated in the context of this hint. The first argument is the name of the orientation (e.g. \"row\"). The second argument is the digit that is in conflict.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder %1$@ kann die Ziffer %2$lld nur einmal enthalten."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each %1$@ can only contain the digit %2$lld once."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each %1$@ can only contain the digit %2$lld once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada %1$@ sólo puede contener el dígito %2$lld una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque %1$@ ne peut contenir qu'une seule fois le chiffre %2$lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各%1$@は数字%2$lldを一度だけ含むことができる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 %1$@에는 숫자 %2$lld를 한 번만 포함할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个 %1$@ 只能包含一次数字 %2$lld。"
          }
        }
      }
    },
    "Either way, %lld must appear in one of the wing cells." : {
