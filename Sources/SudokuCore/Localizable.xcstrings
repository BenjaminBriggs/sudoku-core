    "Any cell that can see both 'roof' cells cannot contain %lld, as this would create a contradiction." : {
      "comment" : "The text of the final step in the explanation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zelle, die beide \"Dach\"-Zellen sehen kann, kann nicht %lld enthalten, da dies einen Widerspruch darstellen würde."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any cell that can see both 'roof' cells cannot contain %lld, as this would create a contradiction."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any cell that can see both 'roof' cells cannot contain %lld, as this would create a contradiction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier celda que pueda ver ambas celdas \"techo\" no puede contener %lld, ya que se crearía una contradicción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute cellule qui peut voir les deux cellules \"toit\" ne peut pas contenir %lld, car cela créerait une contradiction."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方の「屋根」のセルを見ることができるセルは、%lldを含むことができない。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'지붕' 셀을 모두 볼 수 있는 셀은 모순이 발생하므로 %lld를 포함할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何可以同时看到 \"屋顶 \"单元格的单元格都不能包含 %lld，因为这会产生矛盾。"
          }
        }
      }
    },
    "Any cell that can see both of these cells cannot contain %lld." : {
      "localizations" : {
