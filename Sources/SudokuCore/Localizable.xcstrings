          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un extremo del enlace fuerte se alinea con el rectángulo. Si %1$lld no está en ese extremo, el rectángulo fuerza que %2$lld esté en una posición que lo elimina de la celda objetivo."
          }
        },
        "fr" : {
          "stringUnit" : {
