          }
        }
      }
    },
    "One end of the strong link aligns with the rectangle. If %lld is not at that end, the rectangle forces %lld into a position that eliminates it from the target cell." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ende des starken Links stimmt mit dem Rechteck überein. Ist %1$lld nicht am Ende, zwingt das Rechteck %2$lld in eine Position, die es aus der Zielzelle entfernt."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One end of the strong link aligns with the rectangle. If %1$lld is not at that end, the rectangle forces %2$lld into a position that eliminates it from the target cell."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
