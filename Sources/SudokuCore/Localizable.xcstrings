    "This means %@ cannot appear in any other cells in this %@." : {
      "comment" : "The text for the final step of the naked subset explanation. The placeholder `@digits` is replaced with a comma-separated list of the naked subset digits.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
